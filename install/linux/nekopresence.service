[Unit]
Description=NekoPresence Key desktop agent
After=network-online.target graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/nekopresence --listen 0.0.0.0:45873 --config %h/.config/nekopresence/config.json --timeout 20
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
