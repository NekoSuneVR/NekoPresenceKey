<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="NekoPresence Key" android:textSize="28sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:text="Pair this Android device to one trusted PC. Wi-Fi alone never unlocks it."
            android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/host" android:hint="PC LAN IP (example 192.168.1.50)" android:inputType="textUri"
            android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/code" android:hint="6-digit pairing code" android:inputType="number"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/pairButton" android:text="Pair device"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/startButton" android:text="Start presence key"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/stopButton" android:text="Stop"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/status" android:text="Not paired" android:textSize="17sp"
            android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/keyInfo" android:textIsSelectable="true" android:textSize="12sp"
            android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
